{
  "description": "仅用于自带本地靶场。qa_topic_owner/other 为公开测试账号。先运行 scripts/run_permission_state_topic.py 初始化账号，或自行注册。",
  "cases": [
    {
      "name": "AUTH-01 · 未登录不能读取任务",
      "test_type": "api",
      "source": "manual",
      "skip_auth": true,
      "tags": [
        "权限状态专题",
        "认证"
      ],
      "content": {
        "workflow": [
          {
            "name": "匿名列表",
            "method": "GET",
            "url": "/api/tasks",
            "headers": {
              "Content-Type": "application/json"
            },
            "assertions": [
              {
                "type": "status_code",
                "operator": "eq",
                "expected": 401
              }
            ]
          }
        ],
        "test_design": {
          "id": "AUTH-01",
          "rule": "认证边界：无 Token 返回 401",
          "technique": "权限决策表 / 状态转换 / 负向测试"
        }
      }
    },
    {
      "name": "AUTH-02 · 所有者可修改任务",
      "test_type": "api",
      "source": "manual",
      "skip_auth": true,
      "tags": [
        "权限状态专题",
        "权限"
      ],
      "content": {
        "workflow": [
          {
            "name": "登录owner",
            "method": "POST",
            "url": "/api/login",
            "headers": {
              "Content-Type": "application/json"
            },
            "assertions": [
              {
                "type": "status_code",
                "operator": "eq",
                "expected": 200
              }
            ],
            "body": {
              "username": "qa_topic_owner",
              "password": "Target-demo-only!"
            },
            "capture": [
              {
                "variable": "owner_token",
                "json_path": "access_token"
              }
            ]
          },
          {
            "name": "创建自己的任务",
            "method": "POST",
            "url": "/api/tasks",
            "headers": {
              "Content-Type": "application/json",
              "Authorization": "Bearer {{owner_token}}"
            },
            "assertions": [
              {
                "type": "status_code",
                "operator": "eq",
                "expected": 201
              }
            ],
            "body": {
              "title": "权限与状态专题",
              "priority": "medium"
            },
            "capture": [
              {
                "variable": "task_id",
                "json_path": "id"
              }
            ]
          },
          {
            "name": "修改标题",
            "method": "PUT",
            "url": "/api/tasks/{{task_id}}",
            "headers": {
              "Content-Type": "application/json",
              "Authorization": "Bearer {{owner_token}}"
            },
            "assertions": [
              {
                "type": "status_code",
                "operator": "eq",
                "expected": 200
              },
              {
                "type": "json_path",
                "target": "title",
                "operator": "eq",
                "expected": "修改后的标题"
              }
            ],
            "body": {
              "title": "修改后的标题"
            }
          }
        ],
        "test_design": {
          "id": "AUTH-02",
          "rule": "所属资源允许编辑",
          "technique": "权限决策表 / 状态转换 / 负向测试"
        }
      }
    },
